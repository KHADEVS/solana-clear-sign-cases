{
  "kind": "programNode",
  "name": "system",
  "publicKey": "11111111111111111111111111111111",
  "docs": ["Display metadata written for these cases, in the sRFC 39 draft form."],
  "instructions": [
    {
      "kind": "instructionNode",
      "name": "transferSol",
      "display": {
        "kind": "instructionDisplayNode",
        "intent": "Transfer SOL",
        "interpolatedIntent": "Transfer {amount} to {destination}"
      },
      "accounts": [
        { "kind": "instructionAccountNode", "name": "source", "isWritable": true, "isSigner": true,
          "display": { "kind": "accountDisplayNode", "skip": "always" } },
        { "kind": "instructionAccountNode", "name": "destination", "isWritable": true, "isSigner": false,
          "display": { "kind": "accountDisplayNode", "label": "To" } }
      ],
      "arguments": [
        { "kind": "instructionArgumentNode", "name": "discriminator",
          "type": { "kind": "numberTypeNode", "format": "u32", "endian": "le" },
          "defaultValue": { "kind": "numberValueNode", "number": 2 },
          "display": { "kind": "argumentDisplayNode", "skip": "always" } },
        { "kind": "instructionArgumentNode", "name": "amount",
          "type": { "kind": "numberTypeNode", "format": "u64", "endian": "le" },
          "display": { "kind": "argumentDisplayNode", "label": "Amount",
            "formatter": { "kind": "amountFormatterNode", "isNative": true } } }
      ],
      "discriminators": [ { "kind": "fieldDiscriminatorNode", "name": "discriminator", "offset": 0 } ]
    },
    {
      "kind": "instructionNode",
      "name": "advanceNonceAccount",
      "display": {
        "kind": "instructionDisplayNode",
        "intent": "Advance durable nonce",
        "interpolatedIntent": "Advance durable nonce {nonceAccount}"
      },
      "accounts": [
        { "kind": "instructionAccountNode", "name": "nonceAccount", "isWritable": true, "isSigner": false,
          "display": { "kind": "accountDisplayNode", "label": "Nonce account" } },
        { "kind": "instructionAccountNode", "name": "recentBlockhashesSysvar", "isWritable": false, "isSigner": false,
          "display": { "kind": "accountDisplayNode", "skip": "always" } },
        { "kind": "instructionAccountNode", "name": "nonceAuthority", "isWritable": false, "isSigner": true,
          "display": { "kind": "accountDisplayNode", "label": "Nonce authority" } }
      ],
      "arguments": [
        { "kind": "instructionArgumentNode", "name": "discriminator",
          "type": { "kind": "numberTypeNode", "format": "u32", "endian": "le" },
          "defaultValue": { "kind": "numberValueNode", "number": 4 },
          "display": { "kind": "argumentDisplayNode", "skip": "always" } }
      ],
      "discriminators": [ { "kind": "fieldDiscriminatorNode", "name": "discriminator", "offset": 0 } ]
    }
  ]
}
